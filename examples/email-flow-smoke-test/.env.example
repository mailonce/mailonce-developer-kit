# Use SMTP credentials from your own application or email provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="MailOnce Dev Test <dev@example.com>"

# Used only to construct the sample verification link in link/both mode.
# It can point at localhost or a test/staging application.
VERIFICATION_BASE_URL=https://example.test/verify-email
